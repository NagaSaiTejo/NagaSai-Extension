{
  "manifest_version": 3,
  "name": "NagaSai AI",
  "version": "1.0.0",
  "description": "Your AI-powered reading assistant. Ask questions about any webpage using Gemini, GPT, Groq and more.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "libs/pdf.min.js",
        "libs/pdf.worker.min.js",
        "libs/mammoth.browser.min.js",
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://text.pollinations.ai/*",
    "https://gen.pollinations.ai/*",
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "ui.css",
        "libs/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "_toggle_privacy": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Toggle NagaSai AI privacy mode (hide/show during screen sharing)"
    }
  }
}
